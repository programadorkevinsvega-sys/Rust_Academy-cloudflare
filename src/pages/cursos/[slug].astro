---
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths() {
 return Object.entries(import.meta.glob('../../content/courses/*.md',{eager:true})).map(([path,mod]:[string,any])=>({params:{slug:path.split('/').pop()?.replace(/\.md$/,'')??''},props:{course:mod}}));
}
const {course}=Astro.props;
const {Content,frontmatter}=course;
---
<BaseLayout title={frontmatter.title+' — Rust Academy'} description={frontmatter.description}>
<div class="container course-page"><nav class="breadcrumbs"><a href="/">Inicio</a><span>/</span><a href="/#cursos">Cursos</a><span>/</span><span>{frontmatter.title}</span></nav>
<header class="lesson-hero"><div class="eyebrow"><span class="eyebrow-dot"></span> {frontmatter.language?.toUpperCase()} · {frontmatter.levelLabel||('Nivel '+frontmatter.level)}</div><h1>{frontmatter.title}</h1><p>{frontmatter.description}</p><div class="lesson-meta"><span>◷ {frontmatter.duration||'A tu ritmo'}</span><span>▤ {frontmatter.category||'Curso guiado'}</span><span>🇪🇸 Contenido en español</span></div><div class="lesson-actions"><a class="button button-ghost" href="/#cursos">← Volver a los cursos</a><button class="button button-primary" type="button" data-course-complete={frontmatter.slug||Astro.params.slug} aria-pressed="false">Marcar curso como completado</button></div></header>
<div class="article-layout"><aside class="article-sidebar"><div class="sidebar-sticky"><span class="sidebar-label">EN ESTE CURSO</span><nav id="course-toc"><p class="toc-loading">Preparando índice…</p></nav><div class="sidebar-note"><span>💡</span><p>Lee un tema, prueba el código y continúa con el siguiente.</p></div></div></aside><article class="markdown-content"><Content/><div class="article-end"><div class="end-icon">✓</div><h2>¡Buen trabajo!</h2><p>Cuando termines de practicar, marca este curso como completado. Tu elección se guarda en este navegador.</p><button class="button button-primary" type="button" data-course-complete={frontmatter.slug||Astro.params.slug} aria-pressed="false">Marcar curso como completado</button><a href="/#cursos" class="next-link">Explorar otros cursos <span>→</span></a></div></article></div></div>
<script>
const article=document.querySelector('.markdown-content'),toc=document.querySelector('#course-toc');
if(article&&toc){const headings=[...article.querySelectorAll('h2,h3')];toc.innerHTML='';const list=document.createElement('ul');headings.forEach((h)=>{if(!h.id)h.id=h.textContent?.trim().toLowerCase().replace(/[^\w\s-]/g,'').replace(/\s+/g,'-')||'tema';const li=document.createElement('li');if(h.tagName==='H3')li.classList.add('toc-sub');const a=document.createElement('a');a.href='#'+h.id;a.textContent=h.textContent||'Tema';li.append(a);list.append(li)});toc.append(list)}
</script>
</BaseLayout>
