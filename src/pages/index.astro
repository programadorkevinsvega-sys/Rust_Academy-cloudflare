---
import BaseLayout from '../layouts/BaseLayout.astro';
import { languages } from '../data/languages';
const modules = Object.entries(import.meta.glob('../content/courses/*.md', { eager: true }));
const courses = modules.map(([path, mod]: [string, any]) => ({slug:path.split('/').pop()?.replace(/\.md$/, '') ?? '', ...mod.frontmatter})).sort((a,b)=>(a.order??100)-(b.order??100));
---
<BaseLayout title="Rust Academy — Aprende programación construyendo" description="Cursos prácticos de programación en español. Empieza con Rust y sigue aprendiendo otros lenguajes.">
<section class="hero container"><div class="hero-copy"><div class="eyebrow"><span class="eyebrow-dot"></span> TU SIGUIENTE NIVEL EMPIEZA AQUÍ</div><h1>Aprende a programar.<br/><span>Construye algo real.</span></h1><p class="hero-lead">Una ruta clara para aprender programación desde los fundamentos hasta proyectos reales. A tu ritmo, sin distracciones.</p><div class="hero-actions"><a class="button button-primary" href="#cursos">Explorar cursos <span>↗</span></a><a class="button button-ghost" href="#ruta">Ver la ruta <span>↓</span></a></div><div class="hero-proof"><span class="proof-avatars">K<span>R</span><b>+</b></span><span><strong>Aprende haciendo</strong><small>Lecciones, ejemplos y proyectos</small></span></div></div>
<div class="hero-visual"><div class="visual-glow"></div><div class="code-window"><div class="window-bar"><div class="window-dots"><i></i><i></i><i></i></div><span>main.rs</span><span class="window-lang">RUST</span></div><div class="code-body"><div class="code-line"><span class="ln">1</span><code><em>fn</em> <b>main</b>() {</code></div><div class="code-line"><span class="ln">2</span><code>  <em>let</em> objetivo = <strong>"crear"</strong>;</code></div><div class="code-line"><span class="ln">3</span><code>  <em>let</em> futuro = <strong>"aprender"</strong>;</code></div><div class="code-line"><span class="ln">4</span><code>  println!(<strong>"{} y {}"</strong>,</code></div><div class="code-line"><span class="ln">5</span><code>    objetivo, futuro);</code></div><div class="code-line"><span class="ln">6</span><code>}</code></div></div><div class="code-footer"><span><i></i> Aprende. Practica. Repite.</span><span>UTF-8</span></div></div><div class="floating-chip chip-top"><span>⌘</span> Aprende a tu ritmo</div><div class="floating-chip chip-bottom"><span class="chip-check">✓</span> Progreso guardado localmente</div></div></section>
<section class="stats container"><div class="stat"><span class="stat-icon">↗</span><div><strong>Aprendizaje guiado</strong><small>De lo básico a proyectos</small></div></div><div class="stat"><span class="stat-icon">⌘</span><div><strong>Ejemplos prácticos</strong><small>Código para entender</small></div></div><div class="stat"><span class="stat-icon">◷</span><div><strong>A tu propio ritmo</strong><small>Continúa cuando quieras</small></div></div><div class="stat"><span class="stat-icon">◎</span><div><strong>Progreso privado</strong><small>En tu navegador</small></div></div></section>
<section class="section container" id="lenguajes"><div class="section-heading"><div><div class="eyebrow">UNA ACADEMIA, MUCHAS POSIBILIDADES</div><h2>Elige tu <span>lenguaje.</span></h2><p>Empieza con una base sólida. Amplía tus habilidades a medida que avanzas.</p></div><span class="section-counter">{languages.length.toString().padStart(2,'0')} <small>lenguajes</small></span></div><div class="language-grid">{languages.map((lang)=>{const count=courses.filter((c)=>c.language===lang.id).length;return <article class:list={['language-card','accent-'+lang.accent,{'language-muted':count===0}]}><div class="language-card-top"><span class="language-icon">{lang.icon}</span><span class:list={['status-pill',count?'status-live':'status-soon']}>{count?'Disponible':'Próximamente'}</span></div><h3>{lang.name}</h3><p>{lang.description}</p><div class="language-card-bottom"><span>{count} {count===1?'curso':'cursos'}</span>{count?<a href="#cursos">Explorar <b>↗</b></a>:<span class="coming-soon">En preparación</span>}</div></article>})}</div></section>
<section class="section courses-section" id="cursos"><div class="container"><div class="section-heading"><div><div class="eyebrow">TU RUTA DE APRENDIZAJE</div><h2>Aprende con <span>propósito.</span></h2><p>Cursos organizados para que avances con confianza, un concepto a la vez.</p></div><div class="progress-summary"><span class="progress-ring">✓</span><div><strong data-overall-progress>0%</strong><small>de cursos completados</small></div></div></div><div class="course-toolbar"><label class="search-box"><span>⌕</span><input type="search" placeholder="Buscar un curso o tema..." aria-label="Buscar cursos" data-course-search/><kbd>/</kbd></label><span class="course-count">{courses.length} cursos en la academia</span></div><div class="course-group-label"><span class="group-emoji">🦀</span><div><strong>Ruta de Rust</strong><small>De los fundamentos a la organización del código</small></div><span class="group-line"></span></div><div class="course-grid">{courses.map((course)=><article class="course-card" data-course-card={course.slug} data-search-text={[course.title,course.description,course.language,(course.tags||[]).join(' ')].join(' ')}><div class="course-card-cover"><span class="cover-symbol">{course.language==='rust'?'🦀':'⌘'}</span><span class="cover-level">{course.levelLabel||('Nivel '+course.level)}</span><span class="course-status" data-course-status>Disponible</span><div class="cover-decoration"></div></div><div class="course-card-content"><div class="course-meta"><span>{course.category||'Fundamentos'}</span><span>•</span><span>{course.duration||'A tu ritmo'}</span></div><h3>{course.title}</h3><p>{course.description}</p><div class="course-card-footer"><a class="course-link" href={'/cursos/'+course.slug+'/'}>Ver curso <span>→</span></a><span class="course-level-dot">{course.levelLabel||('Nivel '+course.level)}</span></div></div></article>)}</div></div></section>
<section class="section container" id="ruta"><div class="path-panel"><div class="path-copy"><div class="eyebrow">APRENDER ES UN PROCESO</div><h2>Una habilidad a la vez.<br/><span>Un proyecto a la vez.</span></h2><p>Avanza por niveles, practica con ejemplos y marca tus cursos completados. Tu progreso se guarda en este navegador para que vuelvas cuando quieras.</p><a href="#cursos" class="button button-primary">Comenzar mi ruta <span>↗</span></a></div><div class="path-steps"><div class="path-step active"><span class="step-number">01</span><div><strong>Aprende los fundamentos</strong><small>Variables, tipos, funciones y control de flujo</small></div><span class="step-indicator">✓</span></div><div class="path-connector"></div><div class="path-step"><span class="step-number">02</span><div><strong>Organiza tus programas</strong><small>Structs, enums, módulos y colecciones</small></div><span class="step-indicator">02</span></div><div class="path-connector"></div><div class="path-step"><span class="step-number">03</span><div><strong>Explora otros lenguajes</strong><small>Amplía tu caja de herramientas</small></div><span class="step-indicator">03</span></div></div></div></section>
</BaseLayout>
