---
import '../styles/global.css';
const { title = 'Rust Academy', description = 'Aprende programación paso a paso.' } = Astro.props;
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#0b1220" /><meta name="description" content={description} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title}</title></head>
<body><div class="site-shell">
<header class="topbar"><a class="brand" href="/" aria-label="Rust Academy, inicio"><span class="brand-mark">RA<span>.</span></span><span class="brand-copy">Rust <strong>Academy</strong><small>APRENDE. CONSTRUYE. DOMINA.</small></span></a><nav class="topnav" aria-label="Navegación principal"><a href="/#lenguajes">Lenguajes</a><a href="/#ruta">Ruta de aprendizaje</a><a class="nav-cta" href="/#cursos">Explorar cursos <span>↗</span></a></nav></header>
<main><slot /></main>
<footer class="footer"><a class="brand footer-brand" href="/"><span class="brand-mark">RA<span>.</span></span><span class="brand-copy">Rust <strong>Academy</strong><small>APRENDE. CONSTRUYE. DOMINA.</small></span></a><p>Una academia abierta, estática y extensible. Tu progreso se guarda en este navegador.</p><span class="footer-meta">Hecho para aprender · Sin cuentas · Sin backend</span></footer>
</div>
<script>
const KEY='rust-academy-progress-v1';
const read=()=>{try{return JSON.parse(localStorage.getItem(KEY)||'{"completedCourses":[]}')}catch{return {completedCourses:[]}}};
const save=(p)=>{try{localStorage.setItem(KEY,JSON.stringify(p))}catch{}};
const refresh=()=>{const p=read();document.querySelectorAll<HTMLElement>('[data-course-card]').forEach((card)=>{const done=p.completedCourses.includes(card.dataset.courseCard);const badge=card.querySelector('[data-course-status]');if(badge)badge.textContent=done?'Completado ✓':'Disponible';card.classList.toggle('is-complete',done)});document.querySelectorAll<HTMLButtonElement>('[data-course-complete]').forEach((b)=>{const done=p.completedCourses.includes(b.dataset.courseComplete ?? '');b.setAttribute('aria-pressed',String(done));b.textContent=done?'✓ Curso completado · Desmarcar':'Marcar curso como completado';b.classList.toggle('button-done',done)});const total=document.querySelectorAll('[data-course-card]').length;const completed=document.querySelectorAll('[data-course-card].is-complete').length;document.querySelectorAll<HTMLElement>('[data-overall-progress]').forEach(e=>e.textContent=total?Math.round(completed/total*100)+'%':'0%')};
document.querySelectorAll('[data-course-complete]').forEach((b)=>b.addEventListener('click',()=>{const p=read(),slug=b.dataset.courseComplete ?? '';p.completedCourses=p.completedCourses.includes(slug)?p.completedCourses.filter(x=>x!==slug):[...p.completedCourses,slug];save(p);refresh()}));
const search=document.querySelector<HTMLInputElement>('[data-course-search]');search?.addEventListener('input',()=>{const q=search.value.trim().toLocaleLowerCase('es');document.querySelectorAll('[data-course-card]').forEach(card=>{card.hidden=!(card.dataset.searchText||'').toLocaleLowerCase('es').includes(q)})});
refresh();
</script></body></html>
